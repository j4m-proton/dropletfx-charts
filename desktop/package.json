{
  "name": "dropletfx-charts-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "DropletFX Charts — candlestick charting with MetaTrader 5 order entry",
  "author": "DropletFX",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env DFX_DEV=1 electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fx.droplet.charts",
    "productName": "DropletFX Charts",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "app",
        "filter": [
          "dfx-server.exe",
          "server.py",
          "deriv_api.py",
          "mt5_bridge.py",
          "requirements.txt",
          "static/**/*",
          "brand/**/*"
        ]
      }
    ],
    "win": {
      "target": ["nsis", "zip"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DropletFX Charts"
    }
  }
}
